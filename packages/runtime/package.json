{
  "name": "@hivemap/runtime",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build -w @hivemap/storage && npm run build -w @hivemap/api-contracts && npm run build -w @hivemap/capture && npm run build -w @hivemap/categories && npm run build -w @hivemap/graph-core && npm run build -w @hivemap/projections && npm run build -w @hivemap/scans",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hivemap/api-contracts": "0.2.1",
    "@hivemap/capture": "0.2.1",
    "@hivemap/categories": "0.2.1",
    "@hivemap/graph-core": "0.2.1",
    "@hivemap/projections": "0.2.1",
    "@hivemap/scans": "0.2.1",
    "@hivemap/storage": "0.2.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
